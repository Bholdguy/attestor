# ─────────────────────────────────────────────────────────────────────────────
# Attestor — environment template
#
# Copy to .env.local for local dev (git-ignored). NEVER commit real values.
# Production values are set on the Convex deployment, NOT in any file:
#   npx convex env set FIRECRAWL_API_KEY  fc-xxxxxxxxxxxxxxxxxxxxxxxx
#   npx convex env set OPENAI_API_KEY     sk-xxxxxxxxxxxxxxxxxxxxxxxx
#   npx convex env set AGENTMAIL_API_KEY  am-xxxxxxxxxxxxxxxxxxxxxxxx
#   ...etc
#
# Every *_API_KEY is read ONLY inside Convex actions (server-side). None of
# these are exposed to the browser. See SECURITY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Convex ──────────────────────────────────────────────────────────────────
# Written by `npx convex dev` — the dev deployment this repo is linked to.
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Public Convex URL for the frontend client (safe to expose; not a secret).
# Vite reads VITE_-prefixed vars. Value looks like https://<name>.convex.cloud
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Deploy token for CI (`npx convex deploy`). Store in the CI secret store only,
# never in a committed file. Not a runtime secret.
CONVEX_DEPLOY_KEY=

# ── Firecrawl (server-side only) ────────────────────────────────────────────
# https://www.firecrawl.dev/  — free key = 1,000 credits + higher rate limit.
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base URL — override only if self-hosting Firecrawl.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Allowlisted board host(s) fetch_board_page may hit in live mode (comma-sep).
# Prevents the app being used as an open scrape proxy (SECURITY.md §7).
# D-4 LOCKED target: California DCA — Board of Registered Nursing.
BOARD_HOST_ALLOWLIST=search.dca.ca.gov

# ── OpenAI (server-side only) ──────────────────────────────────────────────
# https://platform.openai.com/  — used ONLY for strict-JSON field extraction.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pinned model id (D-3). Default target for the cheap extraction tier.
# bootModelCheck() calls GET /v1/models once; falls back to OPENAI_MODEL_FALLBACK
# if this id is absent. RE-VERIFY exact id + price against platform.openai.com
# on build day and update DECISIONS.md D-3.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FALLBACK=gpt-4o-2024-08-06
# Cap on extraction output size (defensive; extraction JSON is small).
OPENAI_MAX_OUTPUT_TOKENS=800

# ── AgentMail (server-side only) ──────────────────────────────────────────
# https://www.agentmail.to/  — the alert channel. Sends only; no inbound.
AGENTMAIL_API_KEY=am-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENTMAIL_BASE_URL=https://api.agentmail.to
# The inbox alerts are sent FROM. Create once:
#   POST https://api.agentmail.to/inboxes  { "client_id": "attestor-alerts" }
# then paste the returned inbox id here.
AGENTMAIL_INBOX_ID=attestor-alerts@agentmail.to
# Where mismatch-case alerts go. Use a team alias, not a personal address,
# unless that person consented (SECURITY.md §2).
ALERT_TO=nurse-ops@your-team.example
# Optional human-in-the-loop CC on every alert (AgentMail feature). Leave blank
# to disable. Do NOT default this to the operator's personal email.
ALERT_CC=

# ── App behaviour ─────────────────────────────────────────────────────────
# Live cron sweep cadence (minutes). Demo mode overrides with a compressed
# scheduler chain regardless of this value.
SWEEP_INTERVAL_MINUTES=5
# Spacing between fanned-out per-license fetches (ms) to stay under the
# Firecrawl rate limit (D-7). ~4000ms * roster size should stay < 60s.
FETCH_STAGGER_MS=4000
# Staleness threshold: a confirmed license older than this with no open case
# renders ⚪ Unconfirmed (D-5). Live default 7 days; demo mode uses 20s.
STALENESS_THRESHOLD_MS=604800000
# Start the deployment with demo mode ON (fixtures, zero Firecrawl/OpenAI
# calls). Recommended for the judged URL; flip off for the Beat 3 live proof.
DEMO_MODE_DEFAULT=true
